#!/usr/bin/env bash
# gunquxuexi — ban bilibili (see .bilibili_lib.sh)
set -euo pipefail
source "$(dirname "$0")/.bilibili_lib.sh"

ensure_hosts
ensure_caddy

if is_banned; then
    echo "bilibili already banned."
    exit 0
fi

toggle_hosts ban
toggle_caddy ban
reload_all
echo "bilibili banned. 滚去学习."
